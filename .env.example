# Configuração pública do aplicativo Firebase Web (não inclua segredos)
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_API_KEY=sua-api-key-publica
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_APP_ID=seu-app-id

# Microsoft/Entra configurado como provedor no Firebase Authentication
VITE_MICROSOFT_TENANT_ID=seu-tenant-id
VITE_MICROSOFT_CLIENT_ID=seu-client-id
# Redirect URI a cadastrar: https://seu-projeto.firebaseapp.com/__/auth/handler

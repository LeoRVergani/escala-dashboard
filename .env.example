# Configuração pública do aplicativo Firebase Web (não inclua segredos)
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_API_KEY=sua-api-key-publica
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_APP_ID=seu-app-id

# Backend Express local desta fase (cliente - Vite)
VITE_DASHBOARD_API_BASE_URL=http://127.0.0.1:3001

# Backend Express local desta fase (servidor - lido por server/config.mjs)
DASHBOARD_API_HOST=127.0.0.1
DASHBOARD_API_PORT=3001
DASHBOARD_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

FIREBASE_PROJECT_ID=<PROJECT_ID>
GOOGLE_APPLICATION_CREDENTIALS=/caminho/fora/do/repositorio/service-account.json

# Bootstrap local de dev (NUNCA habilitar em produção) - permite testar o fluxo
# administrativo sem depender do cadastro MSAL/Firebase Auth completo ainda.
DASHBOARD_DEV_LOCAL_AUTH=false
DEV_LOCAL_ADMIN_LOGINS=<LOGIN_ADMIN_LOCAL>
DEV_SESSION_SECRET=<GERE_UM_VALOR_ALEATORIO_LOCAL>

# Só publica/reseta o workspace demo-v1 quando true. Nunca crie um equivalente para produção.
ALLOW_DEMO_FIRESTORE_WRITE=false

# Microsoft/Entra configurado como provedor no Firebase Authentication
VITE_MICROSOFT_TENANT_ID=seu-tenant-id
VITE_MICROSOFT_CLIENT_ID=seu-client-id
# Redirect URI a cadastrar: https://seu-projeto.firebaseapp.com/__/auth/handler
